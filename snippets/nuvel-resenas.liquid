{% capture source %}{% render 'nuvel-resenas-catalogo', product: product %}{% endcapture %}
{% if product != blank %}
{% liquid
  assign rows = source | strip | split: '~~'
  assign total = rows.size
  assign sum = 0
  for row in rows
    assign fields = row | strip | split: '||'
    assign sum = sum | plus: fields.first
  endfor
  assign additional = product.metafields.custom.resenas.value
%}
{{ 'nuvel-reviews.css' | asset_url | stylesheet_tag }}
<section id="NuvelReviews-{{ section_id }}" class="nv-reviews" aria-label="Reseñas de la prenda"><div>
  <h2>Reseñas de la prenda</h2>
  <div class="nv-reviews-layout">
    <aside>
      {% if total > 0 %}
        <strong class="nv-average">{{ sum | times: 1.0 | divided_by: total | round: 1 | replace: '.', ',' }}</strong>
        <small>{{ total }} reseñas</small>
        <ul aria-label="Distribución de valoraciones">
          {% for score in (1..5) reversed %}
            {% assign votes = 0 %}
            {% for row in rows %}
              {% assign value = row | strip | split: '||' | first | plus: 0 %}
              {% if value == score %}{% assign votes = votes | plus: 1 %}{% endif %}
            {% endfor %}
            <li aria-label="{{ score }} estrellas, {{ votes }} reseñas">{{ score }} <progress aria-hidden="true" value="{{ votes }}" max="{{ total }}"></progress> {{ votes }}</li>
          {% endfor %}
        </ul>
      {% elsif product.metafields.reviews.rating.value != blank %}
        <strong class="nv-average">{{ product.metafields.reviews.rating.value.rating | replace: '.', ',' }}</strong>
        <small>{{ product.metafields.reviews.rating_count.value }} reseñas</small>
      {% endif %}
      {% if shop.email != blank %}{% assign subject = 'Opinión sobre ' | append: product.title | url_encode %}<a class="nv-review-action" href="mailto:{{ shop.email | escape }}?subject={{ subject }}">Escribir una reseña</a>{% endif %}
    </aside>
    <div class="nv-review-cards">
      {% for row in rows %}
        {% assign fields = row | strip | split: '||' %}
        {% if forloop.index == 3 %}<details><summary class="nv-review-action">Ver las otras {{ total | minus: 2 }} reseñas</summary><div class="nv-review-cards">{% endif %}
        <article>
          {% assign stars = fields[0] | plus: 0 %}
          <span class="nv-review-stars" aria-label="{{ stars }} de 5 estrellas">{% for i in (1..5) %}{% if i <= stars %}★{% else %}☆{% endif %}{% endfor %}</span>
          <strong>{{ fields[1] | escape }}</strong>
          <p>{{ fields[2] | escape }}</p>
          <small><b>{{ fields[3] | escape }}</b> — {{ fields[4] | escape }}</small>
        </article>
        {% if forloop.last and total > 2 %}</div></details>{% endif %}
      {% endfor %}
      {% for review in additional %}{% if review.texto.value != blank %}<article><p>{{ review.texto.value | escape }}</p><small>{{ review.autor.value | escape }}</small></article>{% endif %}{% endfor %}
      {% if total == 0 and additional == blank %}<p>Aún no hay reseñas publicadas.</p>{% endif %}
    </div>
  </div>
</div></section>
{% endif %}
