{% liquid
  assign titles = 'Producto destacado|Sobre nosotros|Preguntas frecuentes' | split: '|'
  assign existing = menu.links | map: 'title' | join: '|' | downcase | prepend: '|' | append: '|'
%}
{% capture extra_links %}
  {% for title in titles %}
    {% assign needle = title | downcase | prepend: '|' | append: '|' %}
    {% unless existing contains needle %}
      <li>
        <a href="{% render 'nuvel-menu-url', nav_title: title %}"
          {% if variant == 'drawer' %}class="menu-drawer__menu-item menu-drawer__menu-item--mainlist"{% endif %}
        >{{ title }}</a>
      </li>
    {% endunless %}
  {% endfor %}
{% endcapture %}
{% assign extra_links = extra_links | strip %}
{% if extra_links != blank %}
  {% if variant == 'drawer' %}
    {{ extra_links }}
  {% elsif variant == 'desktop' %}
    <li class="menu-list__list-item nuvel-discover">
      <button type="button" class="menu-list__link button-unstyled" popovertarget="NuvelDiscover-{{ section.id }}">Descubrir ▾</button>
      <ul popover id="NuvelDiscover-{{ section.id }}" class="nuvel-discover-links">{{ extra_links }}</ul>
    </li>
  {% endif %}
{% endif %}

{% stylesheet %}
  .nuvel-discover button { anchor-name: --nuvel-discover; white-space: nowrap; }
  .nuvel-discover-links { list-style: none; padding: .5rem; border: 1px solid #ddd; background: #fff; color: #111; }
  .nuvel-discover-links a { display: block; padding: .75rem 1rem; color: inherit; }
  @supports (top: anchor(bottom)) {
    .nuvel-discover-links { position-anchor: --nuvel-discover; inset: auto; top: anchor(bottom); left: anchor(left); margin: 0; }
  }
{% endstylesheet %}
