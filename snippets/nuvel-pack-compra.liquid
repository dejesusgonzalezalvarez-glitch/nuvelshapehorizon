{% liquid
  assign pieces = 2
  assign title = 'Pack de 2 unidades'
  if mode == 'trio'
    assign pieces = 3
    assign title = 'Pack de 3 unidades'
  elsif mode == 'look'
    assign pieces = 3
    assign title = 'Look completo · Faja, short y top'
  endif
  assign pack_available = true
%}
<nuvel-pack-compra data-add="{{ routes.cart_add_url }}.js" data-cart="{{ routes.cart_url }}" data-currency="{{ cart.currency.iso_code | escape }}" data-locale="{{ request.locale.iso_code | escape }}">
  <details>
    {% assign pack_total = 0 %}
    {% capture pack_choices %}
    {% for position in (1..pieces) %}
      {% liquid
        assign item = product
        if mode == 'look' and position == 2
          assign item = short_product
        elsif mode == 'look' and position == 3
          assign item = top_product
        endif
        assign reference_variant = item.selected_or_first_available_variant
        assign pack_total = pack_total | plus: reference_variant.price
        unless item.available
          assign pack_available = false
        endunless
      %}
      <label>
        {% if mode == 'look' %}{{ item.title | escape }}{% else %}Unidad {{ position }}{% endif %}
        <select {% unless item.available %}disabled{% endunless %}>
          {% assign color_option = item.options_by_name['Color'] %}
          {% if color_option.values.size > 1 and item.options.size > 1 %}
            {% assign color_index = color_option.position | minus: 1 %}
            {% for color in color_option.values %}
              {% assign color_name = color.name | default: color %}
              <optgroup label="{% render 'nuvel-opcion', value: color_name %}">
                {% for variant in item.variants %}
                  {% if variant.available and variant.options[color_index] == color_name %}
                    <option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if variant.id == item.selected_or_first_available_variant.id %}selected{% endif %}>{% render 'nuvel-opcion', value: variant.title %} · {{ variant.price | money }}</option>
                  {% endif %}
                {% endfor %}
              </optgroup>
            {% endfor %}
          {% else %}
            {% for variant in item.variants %}
              {% if variant.available %}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if variant.id == item.selected_or_first_available_variant.id %}selected{% endif %}>{% render 'nuvel-opcion', value: variant.title %} · {{ variant.price | money }}</option>
              {% endif %}
            {% endfor %}
          {% endif %}
        </select>
      </label>
    {% endfor %}
    {% endcapture %}
    <summary>
      <span class="nuvel-pack-fotos">{% render 'nuvel-pack-foto', product: product %}
        {% if mode == 'look' %}{% render 'nuvel-pack-foto', product: short_product %}{% render 'nuvel-pack-foto', product: top_product %}
        {% else %}{% render 'nuvel-pack-foto', product: product %}{% if pieces == 3 %}{% render 'nuvel-pack-foto', product: product %}{% endif %}{% endif %}
      </span>
      <span class="nuvel-pack-name">{{ title }}</span>
      {% if pack_available %}
        <span class="nuvel-pack-importes"><strong data-total>{{ pack_total | money }}</strong><small>Ahorro del pack {{ 0 | money }}</small></span>
      {% else %}
        <span>Agotado</span>
      {% endif %}
    </summary>
    {{ pack_choices }}
    {% if pack_available %}
      <button type="button" class="button" data-add-pack disabled>Añadir pack al carrito</button>
    {% else %}
      <p>Pack agotado</p>
    {% endif %}
    <span role="status"></span>
  </details>
</nuvel-pack-compra>
<script type="module" src="{{ 'nuvel-pack-compra.js' | asset_url }}"></script>

{% stylesheet %}
  nuvel-pack-compra { display: block; padding: .85rem; border: 1px solid #000; background: #fff; color: #000; }
  nuvel-pack-compra summary { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-weight: 600; cursor: pointer; }
  .nuvel-pack-name { flex: 1 1 9rem; }
  .nuvel-pack-importes { display: grid; gap: .15rem; margin-inline-start: auto; text-align: end; }
  .nuvel-pack-importes small { font-weight: 400; }
  nuvel-pack-compra label { display: grid; gap: .25rem; margin-block: .75rem; }
  nuvel-pack-compra select { width: 100%; min-height: 44px; font: inherit; color: #000; background: #fff; }
  nuvel-pack-compra [role="status"]:not(:empty) { display: block; margin-top: .75rem; }
{% endstylesheet %}
