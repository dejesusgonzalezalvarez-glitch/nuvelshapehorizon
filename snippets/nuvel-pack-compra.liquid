{% liquid
  assign pieces = 2
  assign title = 'Pack de 2 unidades'
  if third != blank
    assign pieces = 3
  elsif mode == 'trio'
    assign pieces = 3
    assign title = 'Pack de 3 unidades'
  endif
  assign title = pack_name | default: title
  assign pack_available = true
%}
<nuvel-pack-compra data-add="{{ routes.cart_add_url }}.js" data-cart="{{ routes.cart_url }}" data-currency="{{ cart.currency.iso_code | escape }}" data-locale="{{ request.locale.iso_code | escape }}">
  <details>
    {% assign pack_total = 0 %}
    {% capture pack_choices %}
    {% for position in (1..pieces) %}
      {% liquid
        assign item = product
        if position == 2 and second != blank
          assign item = second
        elsif position == 3 and third != blank
          assign item = third
        endif
        assign first_choice = true
      %}
      <label>
        {% if second != blank %}{{ item.title | escape }}{% else %}Unidad {{ position }}{% endif %}
        <select>
          {% assign pack_variants = item.variants %}
          {% if item.handle == 'faja-moldeadora-invisible-nuvel' %}
            {% assign pack_variants = pack_variants | reject: 'option2', '3XL' | reject: 'option2', 'XXXL' %}
          {% endif %}
          {% for variant in pack_variants %}
            {% unless variant.available %}{% continue %}{% endunless %}
            {% if item.handle == 'sujetador-corrector-postura' %}
              {% unless variant.option1 contains '1 Sujetador' %}{% continue %}{% endunless %}
            {% endif %}

            {% if first_choice %}
              {% assign pack_total = pack_total | plus: variant.price %}

              {% assign first_choice = false %}
            {% endif %}
            <option value="{{ variant.id }}" data-price="{{ variant.price }}">{% render 'nuvel-opcion', value: variant.title %} · {{ variant.price | money }}</option>
          {% endfor %}
        </select>
        {% if first_choice %}{% assign pack_available = false %}{% endif %}
      </label>
    {% endfor %}
    {% endcapture %}
    <summary>
      <span class="nuvel-pack-fotos">{% render 'nuvel-pack-foto', product: product %}
        {% assign second_photo = second | default: product %}
        {% render 'nuvel-pack-foto', product: second_photo %}
        {% if pieces == 3 %}{% assign third_photo = third | default: product %}{% render 'nuvel-pack-foto', product: third_photo %}{% endif %}
      </span>
      <span class="nuvel-pack-name">{{ title }}</span>
      {% if pack_available %}
        <span class="nuvel-pack-importes"><strong data-total>{{ pack_total | money }}</strong><small>Ahorro del pack <b>{{ 0 | money }}</b></small></span>
      {% else %}
        <span>Agotado</span>
      {% endif %}
    </summary>
    {{ pack_choices }}
    {% if pack_available %}
      <button type="button" class="button" data-add-pack disabled>Añadir pack al carrito</button>
    {% else %}
      <p>Pack agotado</p>
    {% endif %}
    <span role="status"></span>
  </details>
</nuvel-pack-compra>
<script type="module" src="{{ 'nuvel-pack-compra.js' | asset_url }}"></script>

{% stylesheet %}
  nuvel-pack-compra { display: block; padding: .85rem; border: 1px solid #000; background: #fff; color: #000; }
  nuvel-pack-compra summary { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-weight: 600; cursor: pointer; }
  .nuvel-pack-name { flex: 1 1 9rem; }
  .nuvel-pack-importes { display: grid; gap: .15rem; margin-inline-start: auto; text-align: end; }
  .nuvel-pack-importes small { font-weight: 400; }
  nuvel-pack-compra label { display: grid; gap: .25rem; margin-block: .75rem; }
  nuvel-pack-compra select { width: 100%; min-height: 44px; font: inherit; color: #000; background: #fff; }
  nuvel-pack-compra [role="status"]:not(:empty) { display: block; margin-top: .75rem; }
{% endstylesheet %}
