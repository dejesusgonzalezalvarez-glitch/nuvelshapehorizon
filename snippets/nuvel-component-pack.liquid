{% assign total = 0 %}
{% capture choices %}
  {% for pos in (1..qty) %}
    {% assign item = product %}
    {% if pos == 2 %}{% assign item = second %}{% elsif pos == 3 %}{% assign item = third %}{% endif %}
    {% assign first = true %}
    <label>{{ item.title | escape }}<select>
      {% for v in item.variants %}
        {% unless v.available %}{% continue %}{% endunless %}
        {% if v.title contains '3XL' or v.title contains 'XXXL' %}{% continue %}{% endif %}
        {% if item.handle == 'sujetador-corrector-postura' %}{% unless v.option1 contains '1 Sujetador' %}{% continue %}{% endunless %}{% endif %}
        {% if first %}{% assign total = total | plus: v.price %}{% assign first = false %}{% endif %}
        <option value="{{ v.id }}" data-price="{{ v.price }}">{% render 'nuvel-opcion', value: v.title %}</option>
      {% endfor %}
    </select></label>
    {% if first %}{% assign unavailable = true %}{% endif %}
  {% endfor %}
{% endcapture %}
{% unless unavailable %}
{%- liquid
  assign nv_bf = false
  if settings.nuvel_bf_activo and product.handle == settings.nuvel_bf_producto
    assign nv_bf = true
  endif
-%}
<div class="nv-kind-{{ kind }}" data-component-pack{% if kind == 1 and nv_bf %} data-bf-hide{% endif %}>
<label class="nv-pack">
  <input type="radio" name="id" value="group-{{ kind }}" data-component data-price="{{ total | money | escape }}" {% unless nv_bf %}{% if kind == 1 %}checked{% endif %}{% endunless %}>
  <span class="nv-thumbs">{% render 'nuvel-pack-foto', product: product %}{% render 'nuvel-pack-foto', product: second %}{% if qty == 3 %}{% render 'nuvel-pack-foto', product: third %}{% endif %}</span>
  <span><strong>{{ title | escape }}</strong><span class="nv-meta">{{ qty }} piezas</span></span>
  <span class="nv-price"><span data-unit>{{ total | money }}</span></span>
  {% if kind == 1 and nv_bf == false %}<span class="nv-popular">MÁS ELEGIDO</span>{% endif %}
</label>
<details class="nv-pack-sizes"><summary>Elegir tallas del pack</summary>{{ choices }}</details>
</div>
{% endunless %}
