{% liquid
  case product.handle
    when 'faja-moldeadora-invisible-nuvel'
      assign garment = 'faja'
    when 'sujetador-corrector-postura', 'sujetador-corrector-postura-sin-costuras'
      assign garment = 'sujetador'
    when 'retro-shapewear-top-with-zipper', 'top-moldeador-retro-con-cremallera', 'top-moldeador-retro-con-cremallera-nuvel'
      assign garment = 'top'
    when 'womens-shapewear-dress-jumpsuit', 'body-moldeador-con-falda', 'body-moldeador-con-falda-nuvel'
      assign garment = 'vestido'
    when 'seamless-shapewear-panties', 'bragas-moldeadoras-sin-costuras', 'bragas-moldeadoras-sin-costuras-nuvel'
      assign garment = 'short'
  endcase
%}
{% if garment != blank %}
  <section class="nuvel-fotos-producto" aria-label="La prenda en uso">
    <h2>La prenda en uso</h2>
    <div class="nuvel-modelos">
      {% assign views = 'ugc-1,ugc-2,estudio-1,estudio-2' | split: ',' %}
      {% for view in views %}
        {% assign file = 'nuvel-catalogo-' | append: garment | append: '-' | append: view | append: '.webp' %}
        <a href="{{ file | asset_url }}">
          <img src="{{ file | asset_url }}" width="1080" height="1920" loading="lazy"
            alt="{{ product.title | escape }} en negro. {% if view contains 'estudio' %}Fotografía de estudio{% else %}Escena cotidiana{% endif %}, vista {{ view | split: '-' | last }}.">
        </a>
      {% endfor %}
    </div>

  </section>
{% endif %}

{% stylesheet %}
  .nuvel-fotos-producto { min-width: 0; margin-block: 1.5rem; }
  .nuvel-fotos-producto h2 { font-size: 1.3rem; margin: 0 0 .75rem; }
  .nuvel-modelos { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:4px; }
  .nuvel-modelos img { display:block; width:100%; height:auto; }
  .nuvel-original-gallery { position:relative; isolation:isolate; overflow:clip; }
{% endstylesheet %}
