{% liquid
  case product.handle
    when 'faja-moldeadora-invisible-nuvel'
      assign companion = all_products['seamless-shapewear-panties']
      assign extra = all_products['retro-shapewear-top-with-zipper']
      assign pair_title = 'Faja y short'
      assign set_title = 'Faja, short y top'
    when 'seamless-shapewear-panties'
      assign companion = all_products['sujetador-corrector-postura']
      assign extra = all_products['retro-shapewear-top-with-zipper']
      assign pair_title = 'Short y sujetador'
      assign set_title = 'Short, sujetador y top'
    when 'retro-shapewear-top-with-zipper'
      assign companion = all_products['seamless-shapewear-panties']
      assign extra = all_products['faja-moldeadora-invisible-nuvel']
      assign pair_title = 'Top y short'
      assign set_title = 'Top, short y faja'
    when 'womens-shapewear-dress-jumpsuit'
      assign companion = all_products['seamless-shapewear-panties']
      assign extra = all_products['sujetador-corrector-postura']
      assign pair_title = 'Vestido y short'
      assign set_title = 'Vestido, short y sujetador'
    when 'sujetador-corrector-postura'
      assign companion = all_products['seamless-shapewear-panties']
      assign extra = all_products['womens-shapewear-dress-jumpsuit']
      assign pair_title = 'Sujetador y short'
      assign set_title = 'Sujetador, short y vestido'
  endcase
  assign duo = product.metafields.custom.pack_duo.value | default: duo
  assign trio = product.metafields.custom.pack_trio.value
  assign recommended = product.metafields.custom.pack_recomendado.value
  if product.handle != 'faja-moldeadora-invisible-nuvel'
    assign look = nil
    assign duo = product.metafields.custom.pack_duo.value
  endif
%}
{% capture cards %}
  {% assign rendered = 0 %}
  {% for kind in (1..3) %}
    {% liquid
      assign qty = 2
      assign pack = duo
      assign second = product
      assign third = product
      if kind == 2
        assign pack = trio
        assign qty = 3
      elsif kind == 3
        assign pack = look
        assign qty = 3
        assign second = all_products['seamless-shapewear-panties']
        assign third = all_products['retro-shapewear-top-with-zipper']
      endif
      if pack == blank
        if companion == blank
          continue
        endif
        assign title = 'Pack de 2 unidades'
        assign qty = 2
        if kind == 2
          assign second = companion
          assign title = pair_title
        elsif kind == 3
          assign second = companion
          assign third = extra
          assign title = set_title
          assign qty = 3
        endif
        render 'nuvel-component-pack', product: product, second: second, third: third, qty: qty, title: title, kind: kind
        continue
      endif
      if pack.available == false or pack.id == product.id
        continue
      endif
      assign variant = pack.selected_or_first_available_variant
      assign separate = product.price_min | plus: second.price_min
      if qty == 3
        assign separate = separate | plus: third.price_min
      endif
      assign comparable = true
      if product.price_varies or second.price_varies or second == blank
        assign comparable = false
      endif
      if qty == 3
        if third.price_varies or third == blank
          assign comparable = false
        endif
      endif
      assign popular = false
      if recommended.id == pack.id
        assign popular = true
      elsif recommended == blank and kind == 3
        assign popular = true
      endif
      assign pct = 0
      if comparable and separate > variant.price and separate > 0
        assign pct = separate | minus: variant.price | times: 100.0 | divided_by: separate | round
      endif
    %}
    {% assign rendered = rendered | plus: 1 %}
    <label class="nv-pack">
      <input type="radio" name="id" data-price="{{ variant.price | money | escape }}" data-url="{{ variant.url | escape }}" {% unless pack.has_only_default_variant %}data-options{% endunless %} {% if popular %}checked{% elsif rendered == 1 %}data-first{% endif %} required value="{{ variant.id }}" aria-label="{{ pack.title | escape }}">
      <span class="nv-thumbs">{% render 'nuvel-pack-foto', product: product %}{% render 'nuvel-pack-foto', product: second %}{% if qty == 3 %}{% render 'nuvel-pack-foto', product: third %}{% endif %}</span>
      <span><strong>{{ pack.title | escape }}</strong><span class="nv-meta">{{ qty }} piezas {% if pct > 0 %}<span class="nv-save">Ahorras {{ pct }} %</span>{% endif %}</span></span>
      <span class="nv-price"><span>{{ variant.price | money }}{% if pct > 0 %}<s>{{ separate | money }}</s>{% endif %}</span><small>{{ variant.price | times: 0.9 | round | money }} con código</small></span>
      {% if popular %}<span class="nv-popular">Más popular</span>{% endif %}
    </label>
  {% endfor %}
{% endcapture %}
{% assign cards = cards | strip %}
{% if cards != blank %}
  <nuvel-pack-action><form method="post" action="{{ routes.cart_add_url }}" class="nuvel-controls nv-packs" data-pack-picker data-cart="{{ routes.cart_url }}" data-currency="{{ cart.currency.iso_code }}">
    <h3>Packs</h3><p>Primera compra: −10 % con el código NUVEL10</p>
    {% if cards contains 'checked' %}{{ cards }}{% else %}{{ cards | replace_first: 'data-first', 'checked' }}{% endif %}
    <div class="nv-pack-action"><label>Cantidad <input type="number" name="quantity" min="1" step="1" value="1" required></label><button type="submit" class="button">Añadir al carrito</button></div><span role="status"></span>
  </form></nuvel-pack-action>
  <script type="module" src="{{ 'nuvel-product-options.js' | asset_url }}"></script>
{% endif %}
