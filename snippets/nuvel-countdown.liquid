{%- comment -%}
  Cuenta atrás Black Friday Nuvel (única para toda la tienda).
  Se calcula siempre contra la fecha fija settings.nuvel_bf_fin: no se reinicia por visita, cookie ni almacenamiento.
  Al llegar a cero, assets/nuvel-countdown.js pone data-nuvel-bf="off" en <html> y todo lo marcado con data-bf-only se oculta.

  Parámetros:
  - version: 'grande' | 'barra' | 'carrito' | 'movil'
{%- endcomment -%}
{%- liquid
  assign version = version | default: 'grande'
  assign mostrar = false
  if settings.nuvel_bf_activo and settings.nuvel_bf_fin != blank
    case version
      when 'grande'
        assign mostrar = settings.nuvel_bf_en_producto
      when 'barra'
        assign mostrar = settings.nuvel_bf_en_anuncios
      when 'carrito'
        assign mostrar = settings.nuvel_bf_en_carrito
      when 'movil'
        assign mostrar = settings.nuvel_bf_en_movil
    endcase
  endif
-%}
{%- if mostrar -%}
  <nuvel-countdown
    class="nbf nbf--{{ version }}"
    data-bf-only
    data-version="{{ version }}"
    {% if version == 'grande' -%}
      data-f1="{{ settings.nuvel_bf_fase1 | escape }}"
      data-f2="{{ settings.nuvel_bf_fase2 | escape }}"
      data-f3="{{ settings.nuvel_bf_fase3 | escape }}"
      data-f4="{{ settings.nuvel_bf_fase4 | escape }}"
    {%- endif %}
  >
    {%- case version -%}
      {%- when 'grande' -%}
        <p class="nbf__title">{{ settings.nuvel_bf_titulo }}</p>
        <p class="nbf__sub" data-nbf-title>{{ settings.nuvel_bf_fase1 | escape }}</p>
        <span class="visually-hidden" role="timer" aria-live="off" data-nbf-timer></span>
        <div class="nbf__clock-row" aria-hidden="true">
          <div class="nbf__unit nbf__col--d"><span class="nbf__tile" data-u="d">00</span><span class="nbf__lab">{{ 'nuvel.black_friday.dias' | t }}</span></div>
          <div class="nbf__dots nbf__col--d"><i></i><i></i></div>
          <div class="nbf__unit nbf__col--h"><span class="nbf__tile" data-u="h">00</span><span class="nbf__lab">{{ 'nuvel.black_friday.horas' | t }}</span></div>
          <div class="nbf__dots nbf__col--h"><i></i><i></i></div>
          <div class="nbf__unit"><span class="nbf__tile" data-u="m">00</span><span class="nbf__lab">{{ 'nuvel.black_friday.minutos' | t }}</span></div>
          <div class="nbf__dots"><i></i><i></i></div>
          <div class="nbf__unit"><span class="nbf__tile nbf__tile--s" data-u="s">00</span><span class="nbf__lab">{{ 'nuvel.black_friday.segundos' | t }}</span></div>
        </div>
      {%- when 'barra' -%}
        <span class="nbf__lead">{{ settings.nuvel_bf_barra | escape }}</span>
        <strong class="nbf__clock" data-nbf-compact></strong>
      {%- when 'carrito' -%}
        <span class="nbf__lead">{{ settings.nuvel_bf_carrito | escape }}</span>
        <strong class="nbf__clock" data-nbf-clock></strong>
      {%- when 'movil' -%}
        <strong class="nbf__clock" data-nbf-compact></strong>
    {%- endcase -%}
  </nuvel-countdown>
{%- endif -%}

{% stylesheet %}
  html[data-nuvel-bf='off'] [data-bf-only],
  html:not([data-nuvel-bf]) [data-bf-only] {
    display: none !important;
  }
  html[data-nuvel-bf='on'] [data-bf-hide] {
    display: none !important;
  }

  .nbf {
    --nbf-gold: var(--nuvel-bf-gold, #8a6f4a);
    --nbf-accent: var(--nbf-gold);
    display: block;
    font-family: Poppins, var(--font-body--family, system-ui), sans-serif;
  }
  html[data-nuvel-phase='p3'] .nbf,
  html[data-nuvel-phase='p4'] .nbf {
    --nbf-accent: var(--nuvel-bf-red, #b3261e);
  }

  /* Versión grande (estilo tarjeta negra con línea plateada) */
  .nbf--grande {
    position: relative;
    width: 100%;
    margin: 0.75rem 0;
    padding: 20px 16px 16px;
    overflow: hidden;
    border: 1px solid #232425;
    border-radius: 10px;
    background: #080808;
    color: #fff;
    text-align: center;
    font-family: Inter, var(--font-body--family, system-ui), 'Segoe UI', sans-serif;
  }
  .nbf--grande::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #6d7178, #e9ebee 30%, #9aa0a7 55%, #f4f5f7 80%, #6d7178);
  }
  html[data-nuvel-phase='p3'] .nbf--grande::before,
  html[data-nuvel-phase='p4'] .nbf--grande::before {
    background: var(--nuvel-bf-red, #b3261e);
  }
  .nbf__title {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #fff;
  }
  .nbf__title b,
  .nbf__title strong {
    font-weight: 700;
    color: #b9bdc3;
  }
  .nbf__sub {
    margin: 2px 0 14px;
    font-size: 13px;
    color: #8b9097;
  }
  html[data-nuvel-phase='p3'] .nbf__sub,
  html[data-nuvel-phase='p4'] .nbf__sub {
    color: #ffb4ab;
    font-weight: 600;
  }
  .nbf__clock-row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 6px;
  }
  .nbf__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 70px;
    min-width: 0;
  }
  .nbf__tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 60px;
    overflow: hidden;
    border: 1px solid #2e2f31;
    border-radius: 8px;
    background: linear-gradient(180deg, #1c1c1d, #111112);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }
  .nbf__tile::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(0, 0, 0, 0.7);
  }
  .nbf__lab {
    font-size: 12px;
    color: #8b9097;
  }
  .nbf__dots {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    height: 60px;
  }
  .nbf__dots i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #b9bdc3;
  }
  html[data-nuvel-phase='p4'] .nbf--grande .nbf__col--d,
  html[data-nuvel-phase='p4'] .nbf--grande .nbf__col--h {
    display: none;
  }
  @media (max-width: 360px) {
    .nbf__unit { width: 58px; }
    .nbf__tile { height: 52px; font-size: 28px; }
    .nbf__dots { height: 52px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    html[data-nuvel-phase='p3'] .nbf__tile--s,
    html[data-nuvel-phase='p4'] .nbf__tile--s {
      animation: nbf-pulse 1s ease-in-out infinite;
    }
  }
  @keyframes nbf-pulse {
    50% { border-color: var(--nuvel-bf-red, #b3261e); }
  }

  /* Versión barra de anuncios */
  .nbf--barra {
    padding: 8px 16px;
    background: #111;
    color: #fff;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  html[data-nuvel-phase='p3'] .nbf--barra,
  html[data-nuvel-phase='p4'] .nbf--barra {
    background: var(--nuvel-bf-red, #b3261e);
  }
  .nbf--barra .nbf__clock {
    margin-left: 4px;
    font-variant-numeric: tabular-nums;
    color: var(--nbf-gold);
  }
  html[data-nuvel-phase='p3'] .nbf--barra .nbf__clock,
  html[data-nuvel-phase='p4'] .nbf--barra .nbf__clock {
    color: #fff;
  }

  /* Versión carrito */
  .nbf--carrito {
    margin: 0 0 12px;
    padding: 10px 12px;
    border-radius: 8px;
    background: #111;
    color: #fff;
    font-size: 13px;
    text-align: center;
  }
  .nbf--carrito .nbf__clock {
    margin-left: 4px;
    font-variant-numeric: tabular-nums;
    color: var(--nbf-accent);
  }
  html[data-nuvel-phase='p3'] .nbf--carrito .nbf__clock,
  html[data-nuvel-phase='p4'] .nbf--carrito .nbf__clock {
    color: #ffb4ab;
  }

  /* Versión barra móvil */
  .nbf--movil {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }
{% endstylesheet %}
