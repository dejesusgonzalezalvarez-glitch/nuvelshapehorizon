{%- assign parts = value | append: '' | split: ' / ' -%}
{%- for part in parts -%}
  {%- unless forloop.first %} / {% endunless -%}
  {%- assign key = part | strip | downcase -%}
  {%- assign packed = key | split: ' (' -%}
  {%- if packed.size > 1 -%}{%- assign key = packed.first -%}{%- endif -%}
  {%- case key -%}
    {%- when 'black' -%}Negro
    {%- when 'black a' -%}Negro · modelo A
    {%- when 'black b' -%}Negro · modelo B
    {%- when 'pink' -%}Rosa
    {%- when 'skin' -%}Beige
    {%- when 'skin color', 'skin colour', 'skintone' -%}Beige
    {%- when 'brown' -%}Marrón
    {%- when 'white' -%}Blanco
    {%- when 'gray' -%}Gris
    {%- when 'grey' -%}Gris
    {%- when 'no color' -%}Único
    {%- when 'size' -%}Talla
    {%- when 'colour' -%}Color
    {%- when 'default title' -%}Única
    {%- else -%}{{ part | escape }}
  {%- endcase -%}
  {%- if packed.size > 1 and parts.size == 1 -%}
    {%- assign size = packed.last | remove: ')' | replace: 'medium', 'm' | replace: 'large', 'l' | replace: 'small', 's' -%}
    {{- ' · ' | append: size | upcase | escape -}}
  {%- endif -%}
{%- endfor -%}
