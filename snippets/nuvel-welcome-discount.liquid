<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&display=swap" rel="stylesheet">
<dialog id="nuvel-welcome" aria-labelledby="nuvel-popup-t nuvel-popup-lead">
  <div class="popup">
    <button class="close" id="nuvel-popup-close" type="button" aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <h2 class="amount" id="nuvel-popup-t">10&nbsp;%</h2>
    <p class="lead" id="nuvel-popup-lead">de descuento en tu primera compra</p>

    <button class="code" id="nuvel-popup-code" type="button" aria-label="Código NUVEL10. Tocar para copiar">NUVEL10</button>

    <button class="copy" id="nuvel-popup-copy" type="button">
      <svg id="nuvel-popup-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
      <span id="nuvel-popup-label">Copiar código</span>
    </button>

    <p class="hint" id="nuvel-popup-hint" role="status" aria-live="polite"></p>

    <button class="dismiss" id="nuvel-popup-dismiss" type="button">No, gracias</button>
  </div>
</dialog>
<button id="nuvel-welcome-reopen" type="button" aria-haspopup="dialog" aria-controls="nuvel-welcome">Mi descuento</button>
{% stylesheet %}

  #nuvel-welcome {
    --ink: #17150f;
    --paper: #fff;
    --mist: #eef0ea;
    --sage: #4f5d4b;
    --muted: #6b6d63;
    --ok: #1f6b3a;
    --font: "Bricolage Grotesque", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  #nuvel-welcome * { box-sizing: border-box; margin: 0; }

  #nuvel-welcome button { font: inherit; cursor: pointer; }
  #nuvel-welcome :focus-visible { outline: 3px solid #2b6fd6; outline-offset: 2px; }

  #nuvel-welcome {
    position: fixed; inset: 0;
    display: grid; place-items: center; padding: 16px;
    background: rgba(12,10,8,.55);
    animation: nuvel-fade .25s ease-out;
  }
  #nuvel-welcome:not([open]) { display: none; }

  #nuvel-welcome .popup {
    position: relative; width: min(100%, 360px);
    padding: 40px 28px 12px; text-align: center; color: var(--ink);
    background: var(--paper); border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0,0,0,.4);
    animation: nuvel-rise .3s cubic-bezier(.2,.8,.2,1);
  }

  #nuvel-welcome .close {
    position: absolute; top: 8px; right: 8px; width: 44px; height: 44px;
    display: grid; place-items: center; border: 0; border-radius: 50%;
    background: none; color: var(--muted);
  }
  #nuvel-welcome .close:hover { background: var(--mist); }
  #nuvel-welcome .close svg { width: 18px; height: 18px; }

  /* Nivel 1: el beneficio */
  #nuvel-welcome .amount { font-size: 5.5rem; line-height: .9; font-weight: 700; letter-spacing: -.04em; }

  /* Nivel 3: apoyo */
  #nuvel-welcome .lead { margin-top: 10px; font-size: 1.05rem; color: #46483f; }

  /* Nivel 2b: el código, visible y tocable (también copia) */
  #nuvel-welcome .code {
    display: block; width: 100%; margin-top: 24px; padding: 13px 16px;
    font-size: 1.2rem; font-weight: 700; letter-spacing: .12em; color: var(--ink);
    background: var(--mist); border: 1.5px dashed var(--sage); border-radius: 12px;
    transition: border-color .2s, background .2s;
  }
  #nuvel-welcome .code:hover { background: #e6e9e0; }
  #nuvel-welcome .code.done { border-style: solid; border-color: var(--ok); }

  /* Nivel 2a: acción principal */
  #nuvel-welcome .copy {
    width: 100%; min-height: 54px; margin-top: 10px;
    display: inline-flex; justify-content: center; align-items: center; gap: 8px;
    font-size: 1.05rem; font-weight: 700; color: #fff;
    background: var(--ink); border: 0; border-radius: 14px;
    transition: background .2s;
  }
  #nuvel-welcome .copy:hover { background: #2e2b22; }
  #nuvel-welcome .copy svg { width: 18px; height: 18px; }
  #nuvel-welcome .copy.done { background: var(--ok); }

  /* Siguiente paso: aparece solo tras copiar, reserva su espacio para no mover el layout */
  #nuvel-welcome .hint { min-height: 1.4em; margin-top: 10px; font-size: .92rem; color: var(--ok); font-weight: 500; }

  /* Nivel 4: salida discreta */
  #nuvel-welcome .dismiss {
    margin-top: 2px; min-height: 44px; padding: 0 14px;
    border: 0; background: none; font-size: .9rem; color: var(--muted);
  }
  #nuvel-welcome .dismiss:hover { color: var(--ink); }

  @keyframes nuvel-fade { from { opacity: 0; } }
  @keyframes nuvel-rise { from { opacity: 0; transform: translateY(14px); } }

  #nuvel-welcome-reopen { display: none; }
  @media (max-width: 749px) {
    #nuvel-welcome:not([open]) + #nuvel-welcome-reopen { display: block; position: fixed; bottom: max(1rem, env(safe-area-inset-bottom)); left: 1rem; z-index: 5; padding: .65rem 1rem; border-radius: 2rem; border: 1px solid #dedbd6; background: #fff; color: #17150f; }
  }
  @media (max-width: 749px) {
    #nuvel-welcome { place-items: end center; padding: 0; background: rgba(12,10,8,.3); }
    #nuvel-welcome .popup { width: 100%; border-radius: 20px 20px 0 0; padding-bottom: max(10px, env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) {
    #nuvel-welcome, #nuvel-welcome .popup { animation: none; }
  }

  #nuvel-welcome { border: 0; margin: 0; width: 100%; height: 100%; max-width: none; max-height: none; font-family: var(--font); box-sizing: border-box; }
  #nuvel-welcome::backdrop { background: transparent; }
  #nuvel-welcome .popup { max-height: 100%; overflow-y: auto; }
{% endstylesheet %}
<script>
(() => {
  const dialog = document.getElementById('nuvel-welcome');
  if (!dialog?.showModal) return;
  let seen = false;
  document.getElementById('nuvel-welcome-reopen').addEventListener('click', () => dialog.showModal());
  for (const name of ['localStorage', 'sessionStorage']) {
    try {
      seen = Boolean(window[name].getItem('nuvel-welcome-discount-v1'));
      window[name].setItem('nuvel-welcome-discount-v1', 'seen');
      break;
    } catch { /* El navegador puede restringir el almacenamiento. */ }
  }
  const $ = id => dialog.querySelector('#nuvel-popup-' + id);
  const CODE = 'NUVEL10';

  const close = () => { dialog.close(); };

  async function copyCode() {
    try {
      await navigator.clipboard.writeText(CODE);
    } catch {
      // Respaldo: selecciona el texto para copiarlo a mano
      const r = document.createRange();
      r.selectNodeContents($('code'));
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
      $('hint').textContent = 'Cópialo manualmente: Ctrl/Cmd + C';
      return;
    }
    $('copy').classList.add('done');
    $('code').classList.add('done');
    $('icon').innerHTML = '<path d="M5 12.5l4.5 4.5L19 7.5"/>';
    $('label').textContent = 'Código copiado';
    $('hint').textContent = 'Pégalo al finalizar la compra';
    $('dismiss').textContent = 'Seguir comprando';
  }

  $('copy').addEventListener('click', copyCode);
  $('code').addEventListener('click', copyCode);
  $('close').addEventListener('click', close);
  $('dismiss').addEventListener('click', close);
  dialog.addEventListener('click', e => { if (e.target === dialog) close(); });

  if (!seen) { dialog.showModal(); $('copy').focus(); }
})();
</script>
