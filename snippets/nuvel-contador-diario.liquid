{% assign deadline = product.metafields.custom.fin_oferta %}
<nuvel-contador-diario hidden {% if deadline.type == 'date_time' and deadline.value != blank %}data-end="{{ deadline.value | date: '%s' }}"{% else %}data-daily{% endif %} class="nuvel-contador-faja">
  <span class="nuvel-contador-faja__titulo">{% if deadline.value != blank %}La oferta termina en{% else %}Aprovecha la promoción de hoy{% endif %}</span>
  <strong role="timer" aria-live="off"></strong>
</nuvel-contador-diario>
<script type="module" src="{{ 'nuvel-contador-diario.js' | asset_url }}"></script>
{% stylesheet %}
  nuvel-contador-diario:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem .8rem;
    padding: .75rem 1rem;
    color: #24211e;
    background: #f8f4ef;
    border-radius: .5rem;
  }
  nuvel-contador-diario strong { font-variant-numeric: tabular-nums; }
  nuvel-contador-diario.nuvel-contador-faja:not([hidden]) {
    display: grid;
    width: 100%;
    background: #000;
    color: #fff;
    text-align: center;
  }
  .nuvel-contador-faja strong { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; }
  .nuvel-contador-faja__titulo { font-weight: 600; }
{% endstylesheet %}
