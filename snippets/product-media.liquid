{%- doc -%}
  Renders a product media component.

  @param {object} media - The product media object.
  @param {boolean} [preview_image_only] - Renders only the preview image without controls.
  @param {string} [widths] - Image widths for responsive images.
  @param {string} [sizes] - Image sizes for responsive images.
  @param {string} [loading] - The loading attribute for the image.
  @param {object} [block] - The block object.
  @param {object} [selected_product] - The currently selected product.
  @param {boolean} [first_3d_model] - Indicates if this is the first 3D model.
  @param {boolean} [is_main_product_media] - Indicates if this is the main product image.
  @param {string} [image_ref] - Optional ref attribute for the image element.

  @example
  {% render 'product-media', media: media, preview_image_only: false, loading: 'lazy' %}
{%- enddoc -%}

{% liquid
  assign widths = widths | default: '240, 352, 640, 832, 1200, 1600, 1920, 2560, 3840'
  assign ref_image_to_transition = ''
  if settings.transition_to_main_product
    assign ref_image_to_transition = 'imagesToTransition[]'
  endif
%}

<div
  class="product-media"
  style="--ratio: {{ media.aspect_ratio }}"
  data-media-id="{{ media.id }}"
>
  {% liquid
    assign high_res_url = media.preview_image | image_url: width: 3840
    assign fetch_priority = 'auto'
    if is_main_product_media
      assign fetch_priority = 'high'
    endif
    assign focal_point_style = '--focal-point: ' | append: media.presentation.focal_point | append: ';'
  %}
  {%- capture nuvel_file -%}{% render 'nuvel-photo-file', image: media.preview_image, owner: selected_product, studio_gallery: true %}{%- endcapture -%}
  {% assign nuvel_file = nuvel_file | strip %}
  {% if nuvel_file != blank %}
    {% assign nuvel_ref = image_ref | default: ref_image_to_transition %}
    {% assign nuvel_alt = selected_product.title %}
    {% assign nuvel_label = '' %}
    {% if selected_product.handle == 'faja-moldeadora-invisible-nuvel' %}
      {% if nuvel_file == 'producto-frente.jpg' or nuvel_file == 'nuvel-hover-faja.webp' %}
        {% assign nuvel_label = 'Braguita · Frente' %}
      {% elsif nuvel_file == 'producto-espalda.jpg' or nuvel_file == 'nuvel-faja-modelo-espalda.webp' %}
        {% assign nuvel_label = 'Braguita · Detrás' %}
      {% elsif nuvel_file == 'nuvel-tanga-negro-frente.png' or nuvel_file == 'nuvel-modelo-tanga-frente.png' %}
        {% assign nuvel_label = 'Tanga · Frente' %}
      {% elsif nuvel_file == 'nuvel-corte-tanga-negro.png' or nuvel_file == 'nuvel-modelo-corte-tanga-negro.png' %}
        {% assign nuvel_label = 'Tanga · Detrás' %}
      {% endif %}
      {% if nuvel_label != blank %}
        {% assign nuvel_alt = selected_product.title | append: ' — ' | append: nuvel_label %}
      {% endif %}
    {% endif %}
    {% if nuvel_file == 'nuvel-tanga-negro-frente.png' %}
      {% assign nuvel_alt = 'Body negro de corte tanga, vista delantera sobre fondo blanco.' %}
    {% elsif nuvel_file == 'nuvel-braguita-negro-frente.png' %}
      {% assign nuvel_alt = 'Body negro de corte braguita, vista delantera sobre fondo blanco.' %}
    {% elsif nuvel_file == 'nuvel-corte-tanga-negro.png' %}
      {% assign nuvel_alt = 'Ejemplo de corte tanga del body negro: deja los glúteos más descubiertos. Vista trasera.' %}
    {% elsif nuvel_file == 'nuvel-corte-braguita-negro.png' %}
      {% assign nuvel_alt = 'Ejemplo de corte braguita del body negro: cubre los glúteos. Vista trasera.' %}
    {% elsif nuvel_file == 'nuvel-modelo-corte-braguita-negro.png' %}
      {% assign nuvel_alt = 'Modelo con el body negro en versión braguita, vista trasera de catálogo.' %}
    {% elsif nuvel_file == 'nuvel-modelo-corte-tanga-negro.png' %}
      {% assign nuvel_alt = 'Modelo con el body negro en versión tanga, vista trasera de catálogo.' %}
    {% elsif nuvel_file == 'nuvel-modelo-tanga-frente.png' %}
      {% assign nuvel_alt = 'Modelo con el body negro en versión tanga, vista delantera sobre fondo blanco.' %}
    {% endif %}
    {% render 'nuvel-photo', file: nuvel_file, alt: nuvel_alt, class: 'product-media__image', ref: nuvel_ref, priority: fetch_priority, loading: loading, style: focal_point_style, media_id: media.id %}
    {% if nuvel_label != blank and preview_image_only != true %}
      <span class="nuvel-gallery-label">{{ nuvel_label }}</span>
    {% endif %}
  {% else %}
    {{
      media.preview_image
      | image_url: width: 3840
      | image_tag:
        widths: widths,
        alt: media.alt,
        sizes: sizes,
        loading: loading,
        class: 'product-media__image',
        ref: ref_image_to_transition,
        data_max_resolution: high_res_url,
        fetchpriority: fetch_priority,
        style: focal_point_style,
        ref: image_ref
    }}
  {% endif %}

  {% unless preview_image_only %}
    {%- case media.media_type -%}
      {% when 'model' %}
        <product-model
          data-media-id="{{ media.id }}"
        >
          <button
            class="button deferred-media__poster-button button-unstyled"
            ref="deferredMediaPlayButton"
            on:click="/showDeferredMedia"
          >
            {{
              media.preview_image
              | image_url: width: 3840
              | image_tag:
                widths: widths,
                alt: media.alt,
                sizes: sizes,
                loading: loading,
                class: 'deferred-media__poster-image'
            }}
            <span class="deferred-media__poster-icon">
              <span class="visually-hidden">{{ 'accessibility.play_model' | t }}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                focusable="false"
                class="icon"
                fill="none"
                viewBox="0 0 18 21"
              >
                {% render 'icon', icon: '3d-model' %}
              </svg>
            </span>
          </button>

          <template>
            {% # Should I be using media_tag here instead like on Dawn? 🤔 %}
            {{ media | model_viewer_tag }}
          </template>
        </product-model>
        <button
          class="button button-secondary button-shopify-xr"
          type="button"
          data-shopify-xr
          data-shopify-model3d-id="{{ media.id }}"
          data-shopify-title="{{ selected_product.title | escape }}"
          data-shopify-xr-hidden
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
            class="icon icon-default"
            fill="none"
            viewBox="0 0 18 21"
          >
            {% render 'icon', icon: '3d-model' %}
          </svg>
          {{ 'actions.view_in_your_space' | t }}
        </button>

        {%- if first_3d_model -%}
          <script
            type="application/json"
            id="ProductModelJSON-{{ selected_product.id }}"
          >
            {{ selected_product.media | where: 'media_type', 'model' | json }}
          </script>
        {%- endif -%}
      {% when 'video', 'external_video' %}
        {%- render 'video',
          video: media,
          video_loop: block.settings.video_loop,
          widths: widths,
          sizes: sizes,
          loading: loading,
          disable_controls: true
        -%}
    {% endcase %}
  {% endunless %}
</div>

{% render 'deferred-media-product-model-styles' %}

{% stylesheet %}
  .product-media:has(> .nuvel-gallery-label) {
    position: relative;
    padding-bottom: 2rem;
    box-sizing: border-box;
  }
  .nuvel-gallery-label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    padding: .3rem .5rem;
    text-align: center;
    background: #fff;
    color: #1d1d1f;
    font-size: clamp(.7rem, 1.2vw, .9rem);
    line-height: 1.4;
    pointer-events: none;
  }
  @media (max-width: 749px) {
    .media-gallery--carousel .product-media:has(> .nuvel-gallery-label),
    .media-gallery--grid .product-media:has(> .nuvel-gallery-label) {
      padding-bottom: 3.5rem;
    }
    media-gallery .nuvel-gallery-label { bottom: 1.5rem; }
  }
{% endstylesheet %}
