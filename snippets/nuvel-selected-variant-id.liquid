{%- liquid
  assign selected = product.selected_or_first_available_variant
  if selected.title contains '3XL' or selected.title contains 'XXXL'
    for v in product.variants
      unless v.available
        continue
      endunless
      if v.title contains '3XL' or v.title contains 'XXXL'
        continue
      endif
      assign selected = v
      break
    endfor
  endif
  if product.handle == 'faja-moldeadora-invisible-nuvel'
    assign faja_color = 'Black Triangle'
    assign replacement_variants = product.variants | where: 'option1', faja_color
    if replacement_variants.size == 0
      assign faja_color = 'Black'
    endif
    assign allowed = product.variants | where: 'available', true | reject: 'option2', '3XL' | reject: 'option2', 'XXXL'
    assign default_choices = allowed | where: 'option1', faja_color
    assign selected = default_choices.first | default: allowed.first
    if product.selected_variant != blank
      assign requested = allowed | where: 'id', product.selected_variant.id | first
      assign selected = requested | default: selected
    endif
  endif
  echo selected.id
-%}
