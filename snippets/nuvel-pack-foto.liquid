{% liquid
  case product.handle
    when 'faja-moldeadora-invisible-nuvel'
      assign catalog_front = 'producto-frente.jpg'

    when 'sujetador-corrector-postura', 'sujetador-corrector-postura-sin-costuras'
      assign catalog_front = 'nuvel-sujetador-negro.webp'

    when 'retro-shapewear-top-with-zipper', 'top-moldeador-retro-con-cremallera', 'top-moldeador-retro-con-cremallera-nuvel'
      assign catalog_front = 'corse-negro-frente.jpg'

    when 'womens-shapewear-dress-jumpsuit', 'body-moldeador-con-falda', 'body-moldeador-con-falda-nuvel'
      assign catalog_front = 'vestido-negro-frente.jpg'

    when 'seamless-shapewear-panties', 'bragas-moldeadoras-sin-costuras', 'bragas-moldeadoras-sin-costuras-nuvel'
      assign catalog_front = 'nuvel-short-blanco.webp'

  endcase
%}
{% if catalog_front != blank %}
  <img src="{{ catalog_front | asset_url }}" alt="{{ product.title | escape }}" width="54" height="64" loading="lazy">
{% elsif product.featured_image %}
  {{ product.featured_image | image_url: width: 108 | image_tag: width: 54, height: 64, loading: 'lazy', alt: product.title }}
{% endif %}
