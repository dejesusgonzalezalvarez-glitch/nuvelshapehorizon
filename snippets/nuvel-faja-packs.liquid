{% liquid
  assign same_product_duo = product.metafields.custom.pack_duo.value
  if product.handle == 'faja-moldeadora-invisible-nuvel'
    assign same_product_duo = same_product_duo | default: duo
  endif
  assign same_product_trio = product.metafields.custom.pack_trio.value
  case product.handle
    when 'faja-moldeadora-invisible-nuvel'
      assign second = all_products['seamless-shapewear-panties']
      assign third = all_products['retro-shapewear-top-with-zipper']
      assign pair_title = 'Faja y short'
      assign set_title = 'Faja, short y top'
    when 'seamless-shapewear-panties'
      assign second = all_products['sujetador-corrector-postura']
      assign third = all_products['retro-shapewear-top-with-zipper']
      assign pair_title = 'Short y sujetador'
      assign set_title = 'Short, sujetador y top'
    when 'retro-shapewear-top-with-zipper'
      assign second = all_products['seamless-shapewear-panties']
      assign third = all_products['faja-moldeadora-invisible-nuvel']
      assign pair_title = 'Top y short'
      assign set_title = 'Top, short y faja'
    when 'womens-shapewear-dress-jumpsuit'
      assign second = all_products['seamless-shapewear-panties']
      assign third = all_products['sujetador-corrector-postura']
      assign pair_title = 'Vestido y short'
      assign set_title = 'Vestido, short y sujetador'
    when 'sujetador-corrector-postura'
      assign second = all_products['seamless-shapewear-panties']
      assign third = all_products['womens-shapewear-dress-jumpsuit']
      assign pair_title = 'Sujetador y short'
      assign set_title = 'Sujetador, short y vestido'
  endcase
%}
{% unless product.gift_card? %}
  <section class="nuvel-product-packs" aria-label="Packs">
    <h3>Packs</h3>
    {% render 'nuvel-pack-cantidad', product: product, bundle: same_product_duo, quantity: 2 %}
    {% if second.available %}
      {% render 'nuvel-pack-compra', product: product, second: second, pack_name: pair_title %}
    {% endif %}
      {% if product.handle == 'faja-moldeadora-invisible-nuvel' and look.available and look.id != product.id %}
      {% assign separate_price = product.price_min | plus: second.price_min | plus: third.price_min %}
      {% assign pack_saving = separate_price | minus: look.price_max | at_least: 0 %}
      <a class="nuvel-linked-pack" href="{{ look.url }}">
        <span class="nuvel-pack-fotos">{% render 'nuvel-pack-foto', product: product %}{% render 'nuvel-pack-foto', product: second %}{% render 'nuvel-pack-foto', product: third %}</span>
        <span class="nuvel-pack-name">Look completo · Faja, short y top</span>
        <span class="nuvel-pack-importes">
          <strong>{% if look.price_varies %}Desde {% endif %}{{ look.price | money }}</strong>
          {% if second != blank and third != blank %}
            {% if product.price_varies == false and second.price_varies == false and third.price_varies == false and look.price_varies == false %}<small>Ahorro del pack {{ pack_saving | money }}</small>
            {% elsif pack_saving > 0 %}<small>Ahorras al menos {{ pack_saving | money }}</small>
            {% else %}<small>Ahorro mínimo {{ pack_saving | money }}</small>{% endif %}
          {% endif %}
        </span>
      </a>
      {% elsif second.available and third.available %}
        {% render 'nuvel-pack-compra', product: product, second: second, third: third, pack_name: set_title %}
      {% endif %}
      {% if same_product_trio.available %}
        {% render 'nuvel-pack-cantidad', product: product, bundle: same_product_trio, quantity: 3 %}
      {% endif %}
  </section>
{% endunless %}


{% stylesheet %}
  .nuvel-product-packs {
    display: grid;
    gap: .75rem;
    width: 100%;
    margin-block: 1rem;
    text-align: start;
  }

  .nuvel-linked-pack { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; border: 1px solid currentColor; padding: .85rem; }
  .nuvel-product-packs h3 { margin: 0; }
  .nuvel-pack-fotos { display: inline-flex; gap: .25rem; vertical-align: middle; margin-inline-end: .75rem; }
  .nuvel-pack-fotos img { width: clamp(2.25rem, 7vw, 3.4rem); height: 4rem; object-fit: contain; background: white; }
  .nuvel-product-packs :is(nuvel-pack-compra, .nuvel-linked-pack) { border: 1px solid #dedbd6; border-radius: 16px; padding: 1rem; }
  .nuvel-product-packs .nuvel-pack-importes small { display: inline-block; background: #f4f2ee; color: #37332d; border-radius: 12px; padding: .35rem .65rem; font-size: .875rem; }
{% endstylesheet %}
