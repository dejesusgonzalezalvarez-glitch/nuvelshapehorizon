{% unless product.gift_card? %}
  <section class="nuvel-product-packs" aria-label="Packs">
    <h3>Packs</h3>
    {% if product.handle == 'faja-moldeadora-invisible-nuvel' and duo.available and duo.id != product.id %}
      <a href="{{ duo.url }}">Elegir pack de 2 fajas · {% if duo.price_varies %}Desde {% endif %}{{ duo.price | money }}</a>
    {% else %}
      {% render 'nuvel-pack-compra', product: product, mode: 'duo' %}
    {% endif %}
    {% if product.handle == 'faja-moldeadora-invisible-nuvel' %}
      {% if look.available and look.id != product.id %}
        <a href="{{ look.url }}">Elegir look completo · {% if look.price_varies %}Desde {% endif %}{{ look.price | money }}</a>
      {% else %}
        {% liquid
          assign short_product = all_products['seamless-shapewear-panties'] | default: all_products['bragas-moldeadoras-sin-costuras-nuvel'] | default: all_products['bragas-moldeadoras-sin-costuras']
          assign top_product = all_products['retro-shapewear-top-with-zipper'] | default: all_products['top-moldeador-retro-con-cremallera-nuvel'] | default: all_products['top-moldeador-retro-con-cremallera']
        %}
        {% if short_product != blank and top_product != blank %}
          {% render 'nuvel-pack-compra', product: product, short_product: short_product, top_product: top_product, mode: 'look' %}
        {% endif %}
      {% endif %}
    {% else %}
      {% render 'nuvel-pack-compra', product: product, mode: 'trio' %}
    {% endif %}
  </section>
{% endunless %}

{% stylesheet %}
  .nuvel-product-packs {
    display: grid;
    gap: .75rem;
    width: 100%;
    margin-block: 1rem;
    text-align: start;
  }

  .nuvel-product-packs h3 { margin: 0; }
{% endstylesheet %}
