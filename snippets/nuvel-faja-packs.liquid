{% if product.handle == 'faja-moldeadora-invisible-nuvel' %}
  <div class="nuvel-faja-packs">
  <h2>Packs</h2>
  <p><strong>1 faja</strong> · {{ product.selected_or_first_available_variant.price | money }}</p>
  {% if duo.available and duo.id != product.id %}
    <a href="{{ duo.url }}">2 fajas · {% if duo.price_varies %}Desde {% endif %}{{ duo.price | money }}</a>
  {% endif %}
  {% if look.available and look.id != product.id %}
    <a href="{{ look.url }}">Look completo (short, faja y top) · {% if look.price_varies %}Desde {% endif %}{{ look.price | money }}</a>
  {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .nuvel-faja-packs {
    display: grid;
    gap: .75rem;
    margin-block: 1rem;
  }

  .nuvel-faja-packs > :is(p, a) {
    margin: 0;
    padding: .75rem;
    border: 1px solid var(--color-border);
    border-radius: .5rem;
  }
{% endstylesheet %}